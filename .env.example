NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MUSICBRAINZ_CONTACT_EMAIL=
NEXT_PUBLIC_ENABLE_REMOTE_SEARCH=true

# Optional: real OTP delivery via Resend. With both set, codes are emailed and the
# dev-mode fallback (code returned in the response) is disabled.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Resonote <sign-in@your-domain>"
